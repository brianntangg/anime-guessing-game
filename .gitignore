# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example (no secrets, documents required vars)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — memory and project settings (machine-local)
.claude/

# copyrighted media — download locally with yt-dlp + ffmpeg (see README)
public/media/audio/*.mp3
!public/media/audio/placeholder.mp3
public/media/ost/*.mp3
!public/media/ost/placeholder.mp3
public/media/images/*.jpg
!public/media/images/placeholder.jpg

# temp download dir
/tmp/anime-downloads/
