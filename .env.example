# ── Server ────────────────────────────────────────────────────────────────────

# Port the server listens on. Railway sets this automatically — do not set manually.
# PORT=3000

# Restrict Socket.io connections to your deployed origin (e.g. https://myapp.up.railway.app).
# Leave unset in development — defaults to allowing all origins.
CORS_ORIGIN=https://your-app.up.railway.app

# ── Media (Cloudflare R2) ─────────────────────────────────────────────────────

# Public base URL of your R2 bucket. All media paths are appended to this.
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Leave unset in development — media is served from /public/media/ locally.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Node ──────────────────────────────────────────────────────────────────────

NODE_ENV=production
